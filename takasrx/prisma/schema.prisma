generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipRole {
  MEMBER
  MANAGER
}

enum ListingStatus {
  OPEN
  MATCHED
  CLOSED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum LedgerEntryType {
  TRADE
  INTEREST
  MANUAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  pharmacyName String
  gln          String   @unique
  region       String
  district     String?
  createdAt    DateTime @default(now())

  memberships   GroupMember[]
  createdGroups Group[]       @relation("GroupCreator")
  listings      Listing[]
  offers        Offer[]
  ledgerEntries LedgerEntry[]
}

model Group {
  id          String   @id @default(cuid())
  name        String
  region      String
  description String?
  createdAt   DateTime @default(now())

  creatorId String
  creator   User   @relation("GroupCreator", fields: [creatorId], references: [id])

  members       GroupMember[]
  listings      Listing[]
  ledgerEntries LedgerEntry[]

  @@index([region])
}

model GroupMember {
  id       String           @id @default(cuid())
  groupId  String
  userId   String
  role     MembershipRole   @default(MEMBER)
  status   MembershipStatus @default(PENDING)
  joinedAt DateTime         @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Listing {
  id           String        @id @default(cuid())
  groupId      String
  userId       String
  title        String
  description  String?
  medicineName String
  barkod       String?
  quantity     String?
  totalStock   Int?
  birimFiyat   Float?
  etiketFiyati Float?
  startDate    DateTime?
  endDate      DateTime?
  hedefAlim    Int?
  maxAlim      Int?
  minAlim      Int?
  alimKatlari  Int?
  expiryDate   DateTime?
  status       ListingStatus @default(OPEN)
  createdAt    DateTime      @default(now())

  group  Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers Offer[]
  tiers  ListingTier[]

  @@index([groupId])
}

model ListingTier {
  id              String  @id @default(cuid())
  listingId       String
  order           Int     @default(0)
  minQuantity     Int
  bonusQuantity   Int     @default(0)
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Offer {
  id            String      @id @default(cuid())
  listingId     String
  userId        String
  message       String?
  quantity      Int         @default(1)
  unitPrice     Float?
  bonusQuantity Int         @default(0)
  totalPrice    Float?
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@index([listingId])
}

model LedgerEntry {
  id           String          @id @default(cuid())
  groupId      String
  userId       String
  type         LedgerEntryType
  amount       Float
  note         String?
  offerId      String?
  interestDate DateTime?
  createdAt    DateTime        @default(now())

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer? @relation(fields: [offerId], references: [id])

  @@unique([groupId, userId, interestDate])
  @@index([groupId, userId])
}

DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"

# Bu e-posta ile kayıt olan hesap otomatik olarak sistem admini olur ve
# her gruba ikinci yönetici (TakasRX Admin) olarak eklenir.
SYSTEM_ADMIN_EMAIL="admin@takasrx.app"

# /admin-recovery sayfasından SYSTEM_ADMIN_EMAIL hesabının şifresini
# sıfırlamak için gereken gizli anahtar. Boş bırakılırsa kurtarma
# sayfası devre dışı kalır. Uzun, rastgele bir değer kullanın.
ADMIN_RECOVERY_SECRET=""

# /db-reset sayfasından TÜM veritabanını silip 10 deneme hesabı
# oluşturmak için gereken gizli anahtar. Boş bırakılırsa bu sayfa
# devre dışı kalır. DİKKAT: çok yıkıcı bir işlemi tetikler, bu anahtarı
# sadece gerçekten gerektiğinde ayarlayın ve kullandıktan sonra kaldırın.
DB_RESET_SECRET=""
